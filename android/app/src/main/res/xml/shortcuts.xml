            android:action="com.mrquentinet.matrixcontroller.CHANGE_ADDRESS"
            android:targetClass="com.mrquentinet.matrixcontroller.MainActivity"
            android:targetPackage="com.mrquentinet.matrixcontroller" />
    </shortcut>
</shortcuts>
