{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", {
      "preset": "conventionalcommits"
    }],
    ["@semantic-release/release-notes-generator", {
      "preset": "conventionalcommits"
    }],
    ["@semantic-release/exec", {
      "prepareCmd": "scripts/build-release.sh v${nextRelease.version}"
    }],
    ["@semantic-release/github", {
      "assets": [
        { "path": "dist/firmware.bin", "name": "firmware.bin", "label": "Firmware update (firmware.bin)" }
      ]
    }]
  ]
}
